      </template>

      {{-- Add to Itinerary Button --}}
      <button
        @click="addToItinerary(selectedPoi)"
        x-bind:disabled="isAdded(selectedPoi.id)"
        :class="isAdded(selectedPoi.id)
          ? 'bg-gray-200 dark:bg-gray-700 text-gray-400 dark:text-gray-500 cursor-not-allowed'
          : 'bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white shadow-md hover:shadow-lg'"
        class="w-full py-3 px-4 rounded-xl font-semibold text-sm transition-all flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4" :class="isAdded(selectedPoi.id) ? 'text-gray-400' : 'text-white'" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        <span x-text="isAdded(selectedPoi.id) ? 'Sudah di Rencana' : '+ Tambahkan ke Rencana Perjalanan'"></span>
