{{-- Alpine Component State --}}
<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('popupState', () => ({
      selectedPoi: null,
      currentPhotoIndex: 0,

      onPoiSelected(poi) {
        if (!poi.nearest_stop && poi.transit_stops && poi.transit_stops.length > 0) {
          const sorted = [...poi.transit_stops].sort((a, b) =>
            (a.pivot?.distance_meters || Infinity) - (b.pivot?.distance_meters || Infinity)
          );
          const nearest = sorted[0];
          poi.nearest_stop = {
            id: nearest.id,
            name: nearest.name,
            distance_meters: nearest.pivot?.distance_meters || 0,
            walking_minutes: nearest.pivot?.walking_minutes || Math.round((nearest.pivot?.distance_meters || 0) / 80),
          };
        }
        this.selectedPoi = poi;
        this.currentPhotoIndex = 0;
        document.body.style.overflow = 'hidden';
      },

      closePopup() {
        this.selectedPoi = null;
        this.currentPhotoIndex = 0;
        document.body.style.overflow = '';
      },

      prevPhoto() {
        if (!this.selectedPoi?.photos?.length) return;
        this.currentPhotoIndex = (this.currentPhotoIndex - 1 + this.selectedPoi.photos.length) % this.selectedPoi.photos.length;
      },

      nextPhoto() {
        if (!this.selectedPoi?.photos?.length) return;
        this.currentPhotoIndex = (this.currentPhotoIndex + 1) % this.selectedPoi.photos.length;
      },

      getCategoryIcon(slug) {
        const icons = {
          'kuliner': '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/></svg>',
          'wisata': '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>',
          'penginapan': '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>',
        };
        return icons[slug] || '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>';
      },

      scoreColor(score) {
        if (score >= 8) return 'bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300';
        if (score >= 7) return 'bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300';
        return 'bg-red-100 dark:bg-red-900/60 text-red-700 dark:text-red-300';
      },

      priceLabel(range) {
        const map = { low: 'Rendah', medium: 'Sedang', high: 'Tinggi' };
        return map[range] || range || '-';
      },

      transitLabel(score) {
        if (score >= 8) return 'Sangat Mudah Diakses';
        if (score >= 7) return 'Mudah Diakses';
        return 'Kurang Terjangkau';
      },

      sourceLabel(type) {
        const map = {
          'menu_go': 'MenuGO',
          'struk_go': 'StrukGO',
          'property_go': 'PropertyGO',
          'community_activity': 'Aktivitas Komunitas',
          'field_survey': 'Survei Lapangan',
        };
        return map[type] || type || '—';
      },

      facilityLabel(key) {
        const map = {
          'wifi': 'WiFi', 'ac': 'AC', 'parkir_mobil': 'Parkir Mobil', 'parkir_motor': 'Parkir Motor',
          'parkir_tepi_jalan': 'Parkir Tepi Jalan', 'mushola': 'Mushola', 'toilet': 'Toilet',
          'akses_difabel': 'Akses Difabel', 'kolam_renang': 'Kolam Renang', 'restoran': 'Restoran',
          'gym': 'Gym', 'spa': 'Spa', 'laundry': 'Laundry', 'sarapan': 'Sarapan',
          'halaman': 'Halaman', 'dapur_bersama': 'Dapur Bersama', 'area_bayi': 'Area Bayi',
          'lesehan': 'Lesehan', 'pemandu_wisata': 'Pemandu Wisata', 'kafe': 'Kafe',
          'galeri_seni': 'Galeri Seni', 'tokosouvenir': 'Toko Souvenir', 'workshop': 'Workshop',
          'galeri': 'Galeri', 'museum_kafe': 'Museum Kafe',
        };
        return map[key] || key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
      },

      paymentLabel(key) {
        const map = {
          'cash': 'Tunai', 'qris': 'QRIS', 'kartu_kredit': 'Kartu Kredit',
          'kartu_debit': 'Kartu Debit', 'transfer_bank': 'Transfer Bank',
          'go_pay': 'GoPay', 'ovo': 'OVO',
        };
        return map[key] || key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
      },

      addToItinerary(poi) {
        if (this.isAdded(poi.id)) {
          Alpine.store('toasts').info('POI sudah ada di rencana perjalanan');
          return;
        }
        this.$dispatch('add-to-itinerary', { poi });
        this.closePopup();
        Alpine.store('toasts').success(`"${poi.name}" ditambahkan ke rencana`);
      },

      isAdded(poiId) {
        if (!this.$store.itinerary?.items) return false;
        return this.$store.itinerary.items.some(
          item => (item.poi_id || item.poi?.id) === poiId
        );
      },
    }));
  });
</script>
