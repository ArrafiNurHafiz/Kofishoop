{{-- POI Detail Popup / Overlay --}}
<div
  x-data="popupState()"
  x-show="selectedPoi != null"
  x-on:poi-selected.window="onPoiSelected($event.detail.poi)"
  x-on:keydown.escape.window="closePopup"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center"
  x-cloak
>
  {{-- Backdrop --}}
  <div
    x-show="selectedPoi != null"
    x-transition:enter="transition-opacity duration-200"
    x-transition:leave="transition-opacity duration-150"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm"
    @click="closePopup"
  ></div>

  {{-- Modal: bottom sheet on mobile, centered on desktop --}}
  <div
    x-show="selectedPoi != null"
    x-transition:enter="transition-all duration-300 ease-out"
    x-transition:enter-start="opacity-0 translate-y-8 sm:translate-y-4 sm:scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
    x-transition:leave="transition-all duration-200 ease-in"
    x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
    x-transition:leave-end="opacity-0 translate-y-8 sm:translate-y-4 sm:scale-95"
    class="relative w-full sm:max-w-md max-h-[85vh] sm:max-h-[90vh] overflow-y-auto bg-white dark:bg-gray-900 rounded-t-2xl sm:rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700"
  >
    {{-- Mobile drag handle --}}
    <div class="sm:hidden flex justify-center pt-2 pb-1">
      <div class="w-10 h-1 rounded-full bg-gray-300 dark:bg-gray-600"></div>
    </div>
    {{-- Close Button --}}
    <button
      @click="closePopup"
      class="absolute top-3 right-3 z-10 w-8 h-8 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-full flex items-center justify-center text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-white dark:hover:bg-gray-700 shadow-sm transition-all"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    {{-- Photo Gallery / Hero --}}
    <div class="w-full h-48 bg-gradient-to-br from-emerald-100 via-teal-100 to-cyan-100 dark:from-emerald-900/50 dark:via-teal-900/30 dark:to-cyan-900/20 flex items-center justify-center relative overflow-hidden">
      <template x-if="selectedPoi.photos && selectedPoi.photos.length > 0">
        <div class="relative w-full h-full group">
          <img :src="selectedPoi.photos[currentPhotoIndex]" :alt="selectedPoi.name" class="w-full h-full object-cover transition-all duration-300" />
          {{-- Photo Navigation --}}
          <template x-if="selectedPoi.photos.length > 1">
            <div class="absolute inset-0 flex items-center justify-between px-2 opacity-0 group-hover:opacity-100 transition-opacity">
              <button @click.stop="prevPhoto()" class="w-8 h-8 rounded-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm flex items-center justify-center shadow-md hover:bg-white dark:hover:bg-gray-800 transition-colors">
                <svg class="w-4 h-4 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
              </button>
              <button @click.stop="nextPhoto()" class="w-8 h-8 rounded-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm flex items-center justify-center shadow-md hover:bg-white dark:hover:bg-gray-800 transition-colors">
                <svg class="w-4 h-4 text-gray-700 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </button>
            </div>
          </template>
          {{-- Dots --}}
          <template x-if="selectedPoi.photos.length > 1">
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
              <template x-for="(_, idx) in selectedPoi.photos" :key="idx">
                <div :class="idx === currentPhotoIndex ? 'bg-white' : 'bg-white/50'" class="w-1.5 h-1.5 rounded-full transition-all"></div>
              </template>
            </div>
          </template>
        </div>
      </template>
      <template x-if="!selectedPoi.photos || selectedPoi.photos.length === 0">
        <template x-if="selectedPoi.photo_url">
          <img :src="selectedPoi.photo_url" :alt="selectedPoi.name" class="w-full h-full object-cover" />
        </template>
        <template x-if="!selectedPoi.photo_url">
          <span class="text-7xl opacity-60 select-none" x-html="getCategoryIcon(selectedPoi.category?.slug)"></span>
        </template>
      </template>

      {{-- Category Badge --}}
      <template x-if="selectedPoi.category">
        <div class="absolute top-3 left-3">
          <span class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm text-gray-700 dark:text-gray-300 shadow-sm border border-white/50 dark:border-gray-700/50 flex items-center gap-1.5">
            <span x-html="getCategoryIcon(selectedPoi.category.slug)"></span>
            <span x-text="selectedPoi.category.name"></span>
          </span>
        </div>
      </template>
    </div>

    {{-- Content --}}
    <div class="p-5 space-y-4">
      {{-- Name & Transit Score --}}
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 leading-snug" x-text="selectedPoi.name"></h2>
          <p x-show="selectedPoi.address" class="text-xs text-gray-400 dark:text-gray-500 mt-1 truncate" x-text="selectedPoi.address"></p>
        </div>

        {{-- Rating + Verified --}}
        <div class="flex-shrink-0 flex flex-col items-end gap-1">
          <template x-if="selectedPoi.rating">
            <div class="flex items-center gap-1">
              <div class="flex">
                <template x-for="i in 5" :key="i">
                  <svg class="w-3.5 h-3.5" :class="i <= Math.round(selectedPoi.rating) ? 'text-amber-400' : 'text-gray-300 dark:text-gray-600'" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                </template>
              </div>
              <span class="text-sm font-semibold text-gray-800 dark:text-gray-200" x-text="selectedPoi.rating"></span>
            </div>
          </template>
          <template x-if="selectedPoi.is_verified">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium rounded-full bg-blue-50 dark:bg-blue-900/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
              Terverifikasi
            </span>
          </template>
          <template x-if="selectedPoi.review_count > 0">
            <span class="text-xs text-gray-400 dark:text-gray-500" x-text="Number(selectedPoi.review_count).toLocaleString('id-ID') + ' ulasan'"></span>
          </template>
        </div>
        <template x-if="selectedPoi.transit_friendliness_score != null">
          <div class="flex-shrink-0 text-center">
            <div
              :class="scoreColor(selectedPoi.transit_friendliness_score)"
              class="w-14 h-14 rounded-xl flex flex-col items-center justify-center shadow-sm"
            >
              <span class="text-lg font-bold leading-none" x-text="selectedPoi.transit_friendliness_score"></span>
              <span class="text-[9px] font-medium mt-0.5 opacity-80">Skor</span>
            </div>
          </div>
        </template>
      </div>

      {{-- Description --}}
      <template x-if="selectedPoi.description">
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed" x-text="selectedPoi.description"></p>
      </template>

      {{-- Detail Rows --}}
      <div class="space-y-2.5 bg-gray-50 dark:bg-gray-800/50 rounded-xl p-3.5">
        {{-- Business Status --}}
        <template x-if="selectedPoi.business_status">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Status</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="px-2 py-0.5 text-xs font-medium rounded-full"
                :class="selectedPoi.business_status === 'operational'
                  ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/50 dark:text-emerald-300'
                  : 'bg-red-100 text-red-700 dark:bg-red-900/50 dark:text-red-300'"
                x-text="selectedPoi.business_status === 'operational' ? 'Buka' : selectedPoi.business_status === 'closed_temporarily' ? 'Tutup Sementara' : 'Tutup Permanen'"
              ></span>
            </span>
          </div>
        </template>

        {{-- Phone --}}
        <template x-if="selectedPoi.phone">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Telpon</span>
            <a :href="'tel:' + selectedPoi.phone" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium" x-text="selectedPoi.phone"></a>
          </div>
        </template>

        {{-- WhatsApp --}}
        <template x-if="selectedPoi.whatsapp">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-emerald-500 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">WhatsApp</span>
            <a :href="'https://wa.me/' + selectedPoi.whatsapp.replace(/[^0-9]/g, '')" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium" x-text="selectedPoi.whatsapp"></a>
          </div>
        </template>

        {{-- Website --}}
        <template x-if="selectedPoi.website">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Website</span>
            <a :href="selectedPoi.website" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium truncate" x-text="selectedPoi.website"></a>
          </div>
        </template>

        {{-- Menu URL --}}
        <template x-if="selectedPoi.menu_url">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Menu</span>
            <a :href="selectedPoi.menu_url" target="_blank" rel="noopener noreferrer" class="text-emerald-600 dark:text-emerald-400 hover:underline font-medium truncate">Lihat Menu</a>
          </div>
        </template>

        {{-- Operating Hours --}}
        <template x-if="selectedPoi.operating_hours">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Jam Buka</span>
            <span class="text-gray-800 dark:text-gray-200 font-medium" x-text="selectedPoi.operating_hours"></span>
          </div>
        </template>

        {{-- Price Range --}}
        <template x-if="selectedPoi.price_range">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Harga</span>
            <span class="text-gray-800 dark:text-gray-200 font-medium" x-text="priceLabel(selectedPoi.price_range)"></span>
          </div>
        </template>

        {{-- Nearest Stop --}}
        <div class="flex items-center gap-3 text-sm">
          <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          </svg>
          <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Halte</span>
          <span class="text-gray-800 dark:text-gray-200 font-medium">
            <template x-if="selectedPoi.nearest_stop">
              <span>
                <span x-text="selectedPoi.nearest_stop.name"></span>
                <span class="text-gray-400 dark:text-gray-500 font-normal">
                  (<span x-text="selectedPoi.nearest_stop.distance_meters"></span> m · <span x-text="selectedPoi.nearest_stop.walking_minutes"></span> mnt jalan)
                </span>
              </span>
            </template>
            <template x-if="!selectedPoi.nearest_stop">
              <span class="text-gray-400 dark:text-gray-500 font-normal">Tidak tersedia</span>
            </template>
          </span>
        </div>

        {{-- Transit Score Detail --}}
        <template x-if="selectedPoi.transit_friendliness_score != null">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Transit</span>
            <span class="font-medium" x-text="transitLabel(selectedPoi.transit_friendliness_score)"></span>
          </div>
        </template>

        {{-- Source Data --}}
        <template x-if="selectedPoi.source_type">
          <div class="flex items-center gap-3 text-sm">
            <svg class="w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="text-gray-500 dark:text-gray-400 w-20 flex-shrink-0">Sumber</span>
            <span class="text-gray-800 dark:text-gray-200 font-medium" x-text="sourceLabel(selectedPoi.source_type)"></span>
          </div>
        </template>
      </div>

      {{-- Tags --}}
      <template x-if="selectedPoi.tags && selectedPoi.tags.length > 0">
        <div class="flex flex-wrap gap-1.5">
          <template x-for="tag in selectedPoi.tags" :key="tag">
            <span class="px-2.5 py-1 text-xs rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 border border-gray-200 dark:border-gray-700">
              <span x-text="tag"></span>
            </span>
          </template>
        </div>
      </template>

      {{-- Facilities --}}
      <template x-if="selectedPoi.facilities && selectedPoi.facilities.length > 0">
        <div>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Fasilitas</p>
          <div class="flex flex-wrap gap-1.5">
            <template x-for="facility in selectedPoi.facilities" :key="facility">
              <span class="px-2.5 py-1 text-xs rounded-full bg-sky-50 dark:bg-sky-900/30 text-sky-700 dark:text-sky-300 border border-sky-200 dark:border-sky-800" x-text="facilityLabel(facility)"></span>
            </template>
          </div>
        </div>
      </template>

      {{-- Payment Methods --}}
      <template x-if="selectedPoi.payment_methods && selectedPoi.payment_methods.length > 0">
        <div>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Pembayaran</p>
          <div class="flex flex-wrap gap-1.5">
            <template x-for="method in selectedPoi.payment_methods" :key="method">
              <span class="px-2.5 py-1 text-xs rounded-full bg-violet-50 dark:bg-violet-900/30 text-violet-700 dark:text-violet-300 border border-violet-200 dark:border-violet-800" x-text="paymentLabel(method)"></span>
            </template>
          </div>
        </div>
      </template>

      {{-- Social Media --}}
      <template x-if="selectedPoi.social_media">
        <div>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">Sosial Media</p>
          <div class="flex flex-wrap gap-2">
            <template x-if="selectedPoi.social_media.instagram">
              <a :href="'https://instagram.com/' + selectedPoi.social_media.instagram.replace('@', '')" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-pink-50 dark:bg-pink-900/30 text-pink-600 dark:text-pink-300 border border-pink-200 dark:border-pink-800 hover:bg-pink-100 dark:hover:bg-pink-900/50 transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                <span x-text="selectedPoi.social_media.instagram"></span>
              </a>
            </template>
            <template x-if="selectedPoi.social_media.tiktok">
              <a :href="'https://tiktok.com/@' + selectedPoi.social_media.tiktok.replace('@', '')" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-full bg-gray-900 dark:bg-gray-700 text-white border border-gray-900 dark:border-gray-600 hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
