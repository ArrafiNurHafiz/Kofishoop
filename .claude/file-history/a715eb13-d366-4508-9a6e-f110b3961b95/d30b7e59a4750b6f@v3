/* ========================================
   KOFISHOOP — Vodafone Design System
   Primary: #e60000 | Ink: #25282b | Canvas: #ffffff
   Font: Inter (Vodafone substitute)
   ======================================== */

/* ---------- RESET & BASE ---------- */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    background-color: #ffffff;
    color: #25282b;
    line-height: 1.6;
    overflow-x: hidden;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
}

ul {
    list-style: none;
}

/* ---------- TYPOGRAPHY ---------- */
/* All Inter — no serif, single family throughout */
h1, h2, h3, h4, h5, h6 {
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
}

.display-hero {
    font-size: 144px;
    font-weight: 800;
    line-height: 0.79;
    letter-spacing: -1px;
    text-transform: uppercase;
}

.display-xl {
    font-size: 90px;
    font-weight: 800;
    line-height: 0.93;
}

.display-lg {
    font-size: 48px;
    font-weight: 300;
    line-height: 1.08;
}

.display-md {
    font-size: 40px;
    font-weight: 300;
    line-height: 1.1;
}

.display-sm {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
}

.display-xs {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.0;
}

.eyebrow {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0;
}

.body-lg {
    font-size: 22px;
    font-weight: 400;
    line-height: 1.09;
}

.body-md {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.56;
}

.body-sm {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.25;
}

.caption {
    font-size: 14px;
    font-weight: 400;
    line-height: 1.14;
}

.caption-strong {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
}

.caption-uppercase {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: 0.57px;
    text-transform: uppercase;
}

/* ---------- COLORS ---------- */
.text-ink    { color: #25282b; }
.text-body   { color: #7e7e7e; }
.text-mute   { color: #bebebe; }
.text-white  { color: #ffffff; }
.text-red    { color: #e60000; }

/* ---------- CONTAINER ---------- */
.container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
}

/* ---------- PILL BUTTONS (brand signature) ---------- */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 12px 24px;
    border-radius: 60px;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 28px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid transparent;
}

.btn-primary {
    background: #e60000;
    color: #ffffff;
    border-color: #e60000;
}

.btn-primary:hover {
    background: #cc0000;
    border-color: #cc0000;
}

.btn-outline-red {
    background: #ffffff;
    color: #e60000;
    border: 1px solid #e60000;
}

.btn-outline-red:hover {
    background: #e60000;
    color: #ffffff;
}

.btn-outline-dark {
    background: #ffffff;
    color: #25282b;
    border: 1px solid #25282b;
}

.btn-outline-dark:hover {
    background: #25282b;
    color: #ffffff;
}

.btn-outline-white {
    background: transparent;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.5);
}

.btn-outline-white:hover {
    background: #ffffff;
    color: #25282b;
    border-color: #ffffff;
}

/* ---------- BADGE / CHIP ---------- */
.badge-chip {
    display: inline-block;
    background: #f2f2f2;
    color: #25282b;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;
    padding: 4px 12px;
    border-radius: 32px;
}

/* ---------- CARD (6px radius, no shadow) ---------- */
.card {
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
}

/* ========================================
   NAV BAR — dark, fixed
   ======================================== */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: #25282b;
    padding: 16px 0;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-logo {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.nav-logo i {
    font-size: 1.2rem;
}

.nav-menu {
    display: flex;
    gap: 24px;
}

.nav-link {
    font-size: 16px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
    transition: color 0.2s ease;
}

.nav-link:hover {
    color: #ffffff;
}

/* Hamburger */
.nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
}

.nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: all 0.3s ease;
}

.nav-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
}

.nav-toggle.active span:nth-child(2) {
    opacity: 0;
}

.nav-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
}

/* ========================================
   HERO BAND — dark ink with photo overlay
   ======================================== */
.hero-band {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: #25282b;
    overflow: hidden;
}

.hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
    opacity: 0.5;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(37, 40, 43, 0.8) 0%, rgba(37, 40, 43, 0.3) 100%);
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    padding-top: 80px;
}

.hero-eyebrow {
    display: inline-block;
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 24px;
    letter-spacing: 0;
}

.hero-title {
    font-size: 144px;
    font-weight: 800;
    line-height: 0.79;
    letter-spacing: -1px;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 32px;
}

.hero-tagline {
    font-size: 22px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.8);
    max-width: 500px;
    margin-bottom: 40px;
}

.hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

/* Speechmark orb — red square focal element */
.speechmark-orb {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: #e60000;
    border-radius: 6px;
    color: #ffffff;
    font-size: 1.5rem;
    position: absolute;
    top: 120px;
    right: 32px;
    z-index: 2;
}

/* ========================================
   CONTENT BAND — light canvas sections
   ======================================== */
.content-band {
    padding: 80px 0;
    background: #ffffff;
}

.content-band-soft {
    background: #f2f2f2;
}

/* Section header */
.section-header {
    margin-bottom: 56px;
}

.section-eyebrow {
    display: inline-block;
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    color: #e60000;
    margin-bottom: 16px;
}

.section-title {
    font-size: 48px;
    font-weight: 300;
    line-height: 1.08;
    color: #25282b;
    margin-bottom: 16px;
}

.section-divider {
    width: 60px;
    height: 3px;
    background: #e60000;
    margin-bottom: 0;
}

.section-desc {
    font-size: 18px;
    font-weight: 400;
    color: #7e7e7e;
    max-width: 600px;
    margin-top: 16px;
}

/* ========================================
   ABOUT SECTION
   ======================================== */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
}

.about-text p {
    font-size: 18px;
    font-weight: 400;
    color: #7e7e7e;
    line-height: 1.56;
    margin-bottom: 16px;
}

.about-text p strong {
    color: #25282b;
    font-weight: 600;
}

.about-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 32px;
}

.value-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: #f2f2f2;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 400;
    color: #25282b;
    transition: background 0.2s ease;
}

.value-item i {
    color: #e60000;
    font-size: 1.1rem;
}

.value-item:hover {
    background: #e8e8e8;
}

.about-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.about-img-box {
    width: 100%;
    max-width: 500px;
    aspect-ratio: 4 / 3;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
}

.about-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(37, 40, 43, 0.6) 0%, transparent 40%);
    border-radius: 6px;
}

.about-img-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
}

.about-img-content i {
    font-size: 2rem;
    color: rgba(255, 255, 255, 0.8);
}

.about-img-label {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
}

/* About stats */
.about-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 32px;
}

.stat-item {
    text-align: center;
    padding: 16px 12px;
    background: #f2f2f2;
    border-radius: 6px;
    transition: background 0.2s ease;
}

.stat-item:hover {
    background: #e8e8e8;
}

.stat-number {
    display: block;
    font-size: 32px;
    font-weight: 700;
    color: #e60000;
    line-height: 1.25;
}

.stat-label {
    font-size: 14px;
    color: #7e7e7e;
    margin-top: 4px;
}

/* ========================================
   SERVICES — TAB INTERFACE (Vodafone style)
   ======================================== */

.service-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}

.service-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 32px;
    border: 1px solid #25282b;
    background: #ffffff;
    color: #25282b;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Inter', sans-serif;
}

.service-tab:hover {
    border-color: #e60000;
    color: #e60000;
}

.service-tab.active {
    background: #e60000;
    border-color: #e60000;
    color: #ffffff;
}

.service-tab i {
    font-size: 1rem;
}

/* Panels */
.service-panels {
    position: relative;
    min-height: 300px;
}

.service-panel {
    display: none;
    animation: panelFadeIn 0.4s ease;
}

.service-panel.active {
    display: block;
}

@keyframes panelFadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
}

.panel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: center;
    background: #ffffff;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid #f2f2f2;
}

.panel-image {
    aspect-ratio: 16 / 9;
    background-size: cover;
    background-position: center;
    border-radius: 6px 0 0 6px;
}

.panel-info {
    padding: 32px 32px 32px 0;
}

.panel-title {
    font-size: 32px;
    font-weight: 700;
    color: #25282b;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.panel-title i {
    color: #e60000;
    font-size: 1.5rem;
}

.panel-desc {
    font-size: 18px;
    color: #7e7e7e;
    line-height: 1.56;
    margin-bottom: 24px;
}

.panel-highlights {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
}

.panel-highlight {
    display: flex;
    align-items: flex-start;
    gap: 16px;
}

.hl-icon {
    width: 48px;
    height: 48px;
    background: #f2f2f2;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e60000;
    font-size: 1.2rem;
    flex-shrink: 0;
}

.panel-highlight strong {
    display: block;
    font-size: 18px;
    font-weight: 600;
    color: #25282b;
}

.panel-highlight small {
    font-size: 14px;
    color: #7e7e7e;
}

.panel-price {
    font-size: 16px;
    color: #e60000;
    font-weight: 700;
    padding: 8px 16px;
    background: #f2f2f2;
    border-radius: 32px;
    display: inline-block;
}

/* ========================================
   GALLERY — Vodafone inspired grid
   ======================================== */
.gallery-tags {
    display: flex;
    gap: 8px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}

.gallery-tag {
    padding: 4px 12px;
    border-radius: 32px;
    font-size: 14px;
    font-weight: 700;
    border: 1px solid #bebebe;
    background: #ffffff;
    color: #7e7e7e;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: 'Inter', sans-serif;
}

.gallery-tag:hover,
.gallery-tag.active {
    background: #e60000;
    color: #ffffff;
    border-color: #e60000;
}

.gallery-layout {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr 0.6fr;
    grid-template-rows: auto auto;
    gap: 12px;
}

.gallery-featured {
    grid-row: 1 / 3;
    cursor: pointer;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
}

.gallery-featured-img {
    height: 100%;
    min-height: 480px;
    background-size: cover;
    background-position: center;
    border-radius: 6px;
    position: relative;
    transition: transform 0.4s ease;
}

.gallery-featured:hover .gallery-featured-img {
    transform: scale(1.03);
}

.gallery-featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(37, 40, 43, 0.85) 0%, transparent 50%);
    border-radius: 6px;
    display: flex;
    align-items: flex-end;
    padding: 32px;
}

.gallery-featured-label h3 {
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    margin: 8px 0 4px;
}

.gallery-featured-label p {
    font-size: 16px;
    color: rgba(255,255,255,0.7);
    margin: 0;
}

.gallery-featured-tag,
.gallery-card-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.57px;
    text-transform: uppercase;
    color: #ffffff;
    background: rgba(230, 0, 0, 0.8);
    padding: 4px 12px;
    border-radius: 32px;
}

/* Small cards */
.gallery-card {
    cursor: pointer;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
}

.gallery-card-tall {
    grid-column: 2 / 4;
}

.gallery-card-img {
    height: 220px;
    background-size: cover;
    background-position: center;
    transition: transform 0.4s ease;
    border-radius: 6px;
    position: relative;
}

.gallery-card:hover .gallery-card-img {
    transform: scale(1.03);
}

.gallery-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(37, 40, 43, 0.8) 0%, transparent 45%);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
}

.gallery-card-overlay h4 {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    margin: 8px 0 0;
}

.gallery-card-tag {
    align-self: flex-start;
}

/* Lightbox */
.lightbox {
    position: fixed;
    inset: 0;
    background: rgba(37, 40, 43, 0.95);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 32px;
}

.lightbox.active {
    display: flex;
}

.lightbox-content {
    text-align: center;
    animation: lightboxIn 0.3s ease;
}

@keyframes lightboxIn {
    from { transform: scale(0.9); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.lightbox-img {
    width: 80vw;
    max-width: 800px;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    background-size: cover;
    background-position: center;
    margin: 0 auto;
}

.lightbox-caption {
    margin-top: 16px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 18px;
}

.lightbox-close {
    position: absolute;
    top: 24px;
    right: 32px;
    background: none;
    border: none;
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: color 0.2s ease;
    line-height: 1;
}

.lightbox-close:hover {
    color: #ffffff;
}

/* ========================================
   TESTIMONIALS
   ======================================== */
.testimoni-carousel {
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
}

.carousel-track {
    display: flex;
    transition: transform 0.5s ease;
}

.carousel-slide {
    min-width: 100%;
    padding: 0 16px;
}

.testimoni-card {
    background: #ffffff;
    padding: 40px 32px;
    border-radius: 6px;
    text-align: center;
    border: 1px solid #f2f2f2;
}

.testimoni-stars {
    margin-bottom: 16px;
    color: #e60000;
    font-size: 1rem;
    letter-spacing: 2px;
}

.testimoni-quote {
    font-size: 22px;
    font-weight: 400;
    color: #25282b;
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto 24px;
}

.testimoni-author {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-content: center;
}

.testimoni-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #e60000;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.2rem;
}

.testimoni-author h4 {
    font-size: 18px;
    font-weight: 600;
    color: #25282b;
}

.testimoni-author span {
    font-size: 14px;
    color: #7e7e7e;
}

/* Carousel dots */
.carousel-nav {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
}

.carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #bebebe;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
}

.carousel-dot.active {
    background: #e60000;
    transform: scale(1.3);
}

.carousel-dot:hover {
    background: #7e7e7e;
}

/* Testimonial stats */
.testimoni-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 40px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}

.testimoni-stat {
    text-align: center;
    padding: 16px;
    background: #f2f2f2;
    border-radius: 6px;
}

.testimoni-stat .num {
    font-size: 32px;
    font-weight: 700;
    color: #e60000;
}

.testimoni-stat .lbl {
    font-size: 14px;
    color: #7e7e7e;
    margin-top: 4px;
}

/* ========================================
   CONTACT
   ======================================== */
.kontak-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
}

.kontak-form {
    background: #ffffff;
    padding: 32px;
    border-radius: 6px;
    border: 1px solid #f2f2f2;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: #25282b;
    margin-bottom: 6px;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #25282b;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #25282b;
    background: #ffffff;
    transition: border-color 0.2s ease;
    outline: none;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #e60000;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #bebebe;
}

.form-group textarea {
    resize: vertical;
    min-height: 100px;
}

.form-toast {
    display: none;
    margin-top: 16px;
    padding: 16px 20px;
    background: #f2f2f2;
    color: #25282b;
    border-radius: 6px;
    font-size: 16px;
    font-weight: 400;
    text-align: center;
    gap: 8px;
    align-items: center;
    justify-content: center;
}

.form-toast.show {
    display: flex;
}

.form-toast i {
    font-size: 1.2rem;
    color: #e60000;
}

.kontak-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.info-card {
    display: flex;
    gap: 16px;
    padding: 20px;
    background: #ffffff;
    border-radius: 6px;
    border: 1px solid #f2f2f2;
    transition: border-color 0.2s ease;
}

.info-card:hover {
    border-color: #e60000;
}

.info-card i {
    font-size: 1.3rem;
    color: #e60000;
    margin-top: 4px;
    flex-shrink: 0;
    width: 24px;
    text-align: center;
}

.info-card h4 {
    font-size: 18px;
    font-weight: 600;
    color: #25282b;
    margin-bottom: 4px;
}

.info-card p {
    font-size: 16px;
    color: #7e7e7e;
    line-height: 1.5;
}

/* ========================================
   FOOTER — dark
   ======================================== */
.footer {
    background: #25282b;
    color: rgba(255, 255, 255, 0.8);
    padding: 64px 0 0;
}

.footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 48px;
}

.footer-logo {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
}

.footer-brand p {
    font-size: 16px;
    max-width: 350px;
    margin-bottom: 24px;
    color: rgba(255, 255, 255, 0.6);
}

.footer-social {
    display: flex;
    gap: 12px;
}

.footer-social a {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    transition: all 0.2s ease;
    color: rgba(255, 255, 255, 0.6);
}

.footer-social a:hover {
    background: #e60000;
    border-color: #e60000;
    color: #ffffff;
}

.footer-links h4 {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.57px;
    color: #ffffff;
    margin-bottom: 16px;
}

.footer-links ul li {
    margin-bottom: 8px;
}

.footer-links ul li a {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s ease;
}

.footer-links ul li a:hover {
    color: #ffffff;
}

.footer-hours li {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
    padding: 6px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-hours li:last-child {
    border-bottom: none;
}

.footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 24px 0;
    text-align: center;
}

.footer-bottom p {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.4);
}

/* ========================================
   SCROLL REVEAL (simplified)
   ======================================== */
.reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s ease,
                transform 0.6s ease;
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0);
}

/* ========================================
   RESPONSIVE
   ======================================== */

@media screen and (max-width: 1023px) {
    .hero-title {
        font-size: 90px;
        line-height: 0.93;
    }

    .display-lg,
    .section-title {
        font-size: 40px;
    }

    .content-band {
        padding: 56px 0;
    }

    .about-grid,
    .panel-grid,
    .kontak-grid {
        grid-template-columns: 1fr;
        gap: 32px;
    }

    .panel-info {
        padding: 32px;
    }

    .panel-image {
        border-radius: 6px 6px 0 0;
    }

    .gallery-layout {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
    }

    .gallery-featured {
        grid-row: auto;
        grid-column: 1 / 3;
    }

    .gallery-featured-img {
        min-height: 320px;
    }

    .gallery-card-tall {
        grid-column: auto;
    }

    .footer-container {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
        grid-column: span 2;
    }
}

@media screen and (max-width: 768px) {
    .hero-title {
        font-size: 64px;
        line-height: 0.85;
        letter-spacing: -1px;
    }

    .hero-band {
        min-height: auto;
        padding: 120px 0 64px;
    }

    .speechmark-orb {
        display: none;
    }

    .section-title {
        font-size: 32px;
    }

    .display-lg {
        font-size: 32px;
    }

    .display-md {
        font-size: 28px;
    }

    .display-sm {
        font-size: 24px;
    }

    /* Nav */
    .nav-toggle {
        display: flex;
    }

    .nav-menu {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background: #25282b;
        flex-direction: column;
        padding: 80px 32px 32px;
        gap: 0;
        transition: right 0.3s ease;
    }

    .nav-menu.active {
        right: 0;
    }

    .nav-link {
        padding: 16px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 18px;
    }

    /* Hero */
    .hero-content {
        padding-top: 0;
    }

    .hero-actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }

    /* About */
    .about-values {
        grid-template-columns: 1fr;
    }

    .about-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    /* Services tabs */
    .service-tabs {
        gap: 8px;
    }

    /* Gallery */
    .gallery-layout {
        grid-template-columns: 1fr;
    }

    .gallery-featured {
        grid-column: auto;
    }

    .gallery-featured-img {
        min-height: 280px;
    }

    /* Contact */
    .kontak-grid {
        grid-template-columns: 1fr;
    }

    /* Footer */
    .footer-container {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: auto;
    }
}

@media screen and (max-width: 480px) {
    .container {
        padding: 0 16px;
    }

    .hero-title {
        font-size: 48px;
    }

    .hero-tagline {
        font-size: 18px;
    }

    .section-title {
        font-size: 28px;
    }

    .testimoni-quote {
        font-size: 18px;
    }

    .testimoni-card {
        padding: 24px 16px;
    }
}

@media (prefers-reduced-motion: reduce) {
    .reveal {
        opacity: 1;
        transform: none;
        transition: none;
    }

    html {
        scroll-behavior: auto;
    }
}
