/* ========================================
   KOFISHOOP — Animations (Vodafone style)
   Clean, minimal, no heavy shadows
   ======================================== */

/* Hero entrance stagger */
.hero-eyebrow {
    opacity: 0;
    animation: fadeSlideDown 0.6s ease-out 0.2s forwards;
}
.hero-title {
    opacity: 0;
    animation: fadeSlideUp 0.6s ease-out 0.4s forwards;
}
.hero-tagline {
    opacity: 0;
    animation: fadeSlideUp 0.6s ease-out 0.6s forwards;
}
.hero-actions {
    opacity: 0;
    animation: fadeSlideUp 0.6s ease-out 0.8s forwards;
}

@keyframes fadeSlideDown {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Service card hover */
.service-card {
    transition: transform 0.2s ease, border-color 0.2s ease;
}

/* Info cards hover */
.info-card {
    transition: border-color 0.2s ease, transform 0.2s ease;
}
.info-card:hover {
    transform: translateX(6px);
}

/* Footer social hover */
.footer-social a {
    transition: all 0.2s ease;
}
.footer-social a:hover {
    transform: translateY(-4px) scale(1.1);
}

/* Buttons */
.btn {
    transition: all 0.2s ease;
}
.btn:hover {
    transform: translateY(-2px);
}

/* Gallery hover */
.gallery-item {
    transition: transform 0.3s ease;
}
.gallery-item:hover {
    transform: scale(1.03);
}

/* Carousel dot */
.carousel-dot {
    transition: all 0.3s ease;
}
.carousel-dot.active {
    transform: scale(1.3);
}

/* Toast slide-in */
.form-toast.show {
    animation: toastSlideIn 0.3s ease;
}
@keyframes toastSlideIn {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Smooth scroll reveal */
.reveal {
    will-change: opacity, transform;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-tagline,
    .hero-actions {
        animation: none;
        opacity: 1;
    }

    .reveal {
        will-change: auto;
    }
}
