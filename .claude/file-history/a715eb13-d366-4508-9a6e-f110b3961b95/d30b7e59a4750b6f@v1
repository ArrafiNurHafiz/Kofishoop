/* ========================================
   KOPISOP — 样式表
   温暖棕色氛围，舒适，学生友好
   ======================================== */

/* ---------- RESET & BASE ---------- */
*, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    background-color: #FDF8F0;
    color: #2C1810;
    line-height: 1.7;
    overflow-x: hidden;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
    transition: color 0.3s ease;
}

ul {
    list-style: none;
}

/* ---------- TYPOGRAPHY ---------- */
h1, h2, h3, h4 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    line-height: 1.3;
}

/* ---------- CONTAINER ---------- */
.container {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 1.5rem;
}

/* ---------- BUTTONS ---------- */
.btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    border-radius: 50px;
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.btn-primary {
    background: #6B4226;
    color: #fff;
    border-color: #6B4226;
}

.btn-primary:hover {
    background: #5D3A1A;
    border-color: #5D3A1A;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(107, 66, 38, 0.3);
}

.btn-outline {
    background: transparent;
    color: #6B4226;
    border-color: #6B4226;
}

.btn-outline:hover {
    background: #6B4226;
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(107, 66, 38, 0.2);
}

.btn-full {
    width: 100%;
    justify-content: center;
}

/* ---------- SECTION (base) ---------- */
.section {
    padding: 6rem 0;
    position: relative;
    z-index: 1;
}

/* ---------- STICKY SECTION LAYOUT ----------
   Each section "sticks" as you scroll past,
   creating a stacking card effect.
   Hero stays as full-page cover, then sections stack.
-------------------------------------------------*/
.sticky-section {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
}
.sticky-section .container {
    width: 100%;
    max-height: 100vh;
    overflow-y: auto;
    padding: 4rem 1.5rem;
    box-sizing: border-box;
}

/* Subtle shadow on each sticky section for depth */
.sticky-section::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, transparent, rgba(198, 134, 66, 0.2), transparent);
    z-index: 10;
}

/* Z-index stacking for sticky sections (in DOM order) */
.sticky-section:nth-of-type(1) { z-index: 1; }
.sticky-section:nth-of-type(2) { z-index: 2; }
.sticky-section:nth-of-type(3) { z-index: 3; }
.sticky-section:nth-of-type(4) { z-index: 4; }
.sticky-section:nth-of-type(5) { z-index: 5; }

/* Alternate background for sticky sections */
.sticky-section:nth-of-type(even) {
    background-color: #F5E6D3;
}
.sticky-section:nth-of-type(odd) {
    background-color: #FDF8F0;
}

/* Remove old section overlap and z-index rules */
/* .section + .section { margin-top: -6rem; } */
/* .section:nth-child(2) { z-index: 2; } ... etc */

.section-header {
    text-align: center;
    margin-bottom: 3.5rem;
}

.section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #C68642;
    margin-bottom: 0.75rem;
}

.section-title {
    font-size: 2.2rem;
    color: #2C1810;
    margin-bottom: 0.75rem;
}

.section-divider {
    width: 50px;
    height: 3px;
    background: #C68642;
    margin: 0 auto;
    border-radius: 2px;
}

.section-desc {
    color: #7D6B5A;
    max-width: 500px;
    margin: 1rem auto 0;
    font-size: 1rem;
}

/* ---------- SCROLL REVEAL ---------- */
.reveal {
    opacity: 0;
    transform: translateY(40px) scale(0.97);
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.reveal.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
}

/* Stagger delays for children */
.reveal-stagger > *:nth-child(1) { transition-delay: 0s; }
.reveal-stagger > *:nth-child(2) { transition-delay: 0.1s; }
.reveal-stagger > *:nth-child(3) { transition-delay: 0.2s; }
.reveal-stagger > *:nth-child(4) { transition-delay: 0.3s; }

/* Slide direction variants */
.reveal-left {
    opacity: 0;
    transform: translateX(-50px);
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.reveal-left.visible {
    opacity: 1;
    transform: translateX(0);
}

.reveal-right {
    opacity: 0;
    transform: translateX(50px);
    transition: opacity 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.reveal-right.visible {
    opacity: 1;
    transform: translateX(0);
}

.reveal-scale {
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.reveal-scale.visible {
    opacity: 1;
    transform: scale(1);
}

/* Smooth image reveal */
.reveal-img {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.reveal-img.visible {
    clip-path: inset(0 0 0 0);
}

/* Glow effect on visible elements */
.reveal.visible,
.reveal-left.visible,
.reveal-right.visible,
.reveal-scale.visible {
    animation: glowPulse 3s ease-in-out 1;
}
@keyframes glowPulse {
    0% { filter: brightness(1); }
    50% { filter: brightness(1.03); }
    100% { filter: brightness(1); }
}

/* =========================================
   SCROLL PROGRESS BAR
   ========================================= */
.scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 9999;
    background: transparent;
}
.scroll-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #C68642, #8B5E3C, #6B4226);
    transition: width 0.1s linear;
    border-radius: 0 2px 2px 0;
    box-shadow: 0 0 8px rgba(198, 134, 66, 0.4);
}

/* Hover magnetic pull for cards */
.service-card {
    will-change: transform;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                box-shadow 0.4s ease,
                border-color 0.4s ease;
}
.service-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 16px 40px rgba(44, 24, 16, 0.15);
}

/* ========================================
   NAVIGASI
   ======================================== */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 1rem 0;
    transition: all 0.4s ease;
    background: transparent;
}

.navbar.scrolled {
    background: rgba(253, 248, 240, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 2px 20px rgba(44, 24, 16, 0.08);
    padding: 0.7rem 0;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #FDF8F0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s ease;
}

.nav-logo i {
    font-size: 1.2rem;
}

.navbar.scrolled .nav-logo {
    color: #6B4226;
}

.nav-menu {
    display: flex;
    gap: 2rem;
}

.nav-link {
    font-size: 0.9rem;
    font-weight: 400;
    color: rgba(253, 248, 240, 0.85);
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.3s ease;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #C68642;
    transition: width 0.3s ease;
}

.nav-link:hover {
    color: #fff;
}

.nav-link:hover::after {
    width: 100%;
}

.navbar.scrolled .nav-link {
    color: #7D6B5A;
}

.navbar.scrolled .nav-link:hover {
    color: #6B4226;
}

.navbar.scrolled .nav-link::after {
    background: #6B4226;
}

/* Toggle button (hamburger) */
.nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
}

.nav-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #FDF8F0;
    border-radius: 2px;
    transition: all 0.3s ease;
}

.navbar.scrolled .nav-toggle span {
    background: #6B4226;
}

.nav-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
}

.nav-toggle.active span:nth-child(2) {
    opacity: 0;
}

.nav-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
}

/* ========================================
   HERO
   ======================================== */
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
}

.hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    z-index: 0;
    will-change: transform;
}

/* Gradient overlay on hero background image */
.hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(44, 24, 16, 0.35) 0%, rgba(93, 58, 26, 0.2) 40%, rgba(107, 66, 38, 0.1) 100%);
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(44, 24, 16, 0.25) 0%, rgba(44, 24, 16, 0.05) 100%);
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 5rem;
}

.hero-text {
    color: #FDF8F0;
}

.hero-badge {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #D4A56A;
    margin-bottom: 1rem;
    font-weight: 400;
}

.hero-title {
    font-size: 4rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    line-height: 1.1;
    color: #fff;
    text-shadow: 0 0 30px rgba(212, 165, 106, 0.3);
    animation: titleGlow 4s ease-in-out infinite;
}

@keyframes titleGlow {
    0%, 100% { text-shadow: 0 0 20px rgba(212, 165, 106, 0.2); }
    50% { text-shadow: 0 0 40px rgba(212, 165, 106, 0.5), 0 0 60px rgba(212, 165, 106, 0.2); }
}

.hero-tagline {
    font-size: 1.2rem;
    font-weight: 300;
    color: #D4A56A;
    margin-bottom: 1rem;
}

.hero-desc {
    font-size: 1rem;
    color: rgba(253, 248, 240, 0.7);
    margin-bottom: 2rem;
    max-width: 450px;
}

.hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.hero-actions .btn-outline {
    color: #FDF8F0;
    border-color: rgba(253, 248, 240, 0.4);
}

.hero-actions .btn-outline:hover {
    background: #FDF8F0;
    color: #6B4226;
    border-color: #FDF8F0;
}

/* Hero decoration */
.hero-decoration {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
}

.hero-circle {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(198, 134, 66, 0.15) 0%, transparent 70%);
    border: 2px solid rgba(198, 134, 66, 0.2);
    animation: pulse 4s ease-in-out infinite;
}

.hero-circle-small {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(198, 134, 66, 0.15);
    animation: pulse 4s ease-in-out infinite 1s;
}

.hero-icon {
    position: absolute;
    font-size: 4rem;
    color: rgba(212, 165, 106, 0.6);
    animation: float 6s ease-in-out infinite;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.05); opacity: 1; }
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

/* ========================================
   TENTANG
   ======================================== */
.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
}

.about-text p {
    color: #5D4A3A;
    margin-bottom: 1rem;
    font-size: 0.95rem;
}

.about-text p strong {
    color: #6B4226;
}

.about-values {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
}

.value-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgba(107, 66, 38, 0.06);
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 500;
    color: #6B4226;
    transition: all 0.3s ease;
}

.value-item i {
    color: #C68642;
    font-size: 1.1rem;
}

.value-item:hover {
    background: rgba(107, 66, 38, 0.12);
    transform: translateY(-2px);
}

.about-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.about-img-box {
    width: 320px;
    height: 380px;
    border-radius: 20px;
    background-size: cover;
    background-position: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(44, 24, 16, 0.15);
    transition: transform 0.4s ease;
}

.about-img-box:hover {
    transform: scale(1.02);
}

.about-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44, 24, 16, 0.6) 0%, transparent 40%);
    border-radius: 20px;
}

.about-img-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
}

.about-img-content i {
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.8);
}

.about-img-label {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: #fff;
    font-weight: 600;
}

/* About stats */
.about-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-top: 2rem;
}
.stat-item {
    text-align: center;
    padding: 0.75rem 0.5rem;
    background: rgba(107, 66, 38, 0.06);
    border-radius: 12px;
    transition: all 0.3s ease;
}
.stat-item:hover {
    background: rgba(107, 66, 38, 0.12);
    transform: translateY(-3px);
}
.stat-number {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: #6B4226;
}
.stat-label {
    font-size: 0.7rem;
    color: #7D6B5A;
    margin-top: 0.2rem;
}

/* Service extra features */
.service-features {
    list-style: none;
    margin-top: 1rem;
    text-align: left;
}
.service-features li {
    font-size: 0.8rem;
    color: #7D6B5A;
    padding: 0.3rem 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
}
.service-features li i {
    color: #C68642;
    font-size: 0.7rem;
}

/* Gallery filter tags */
.gallery-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
}
.gallery-tag {
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.8rem;
    border: 1px solid rgba(107, 66, 38, 0.15);
    background: transparent;
    color: #7D6B5A;
    cursor: pointer;
    transition: all 0.3s ease;
}
.gallery-tag:hover,
.gallery-tag.active {
    background: #6B4226;
    color: #fff;
    border-color: #6B4226;
}

/* Testimoni extra stats */
.testimoni-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
}
.testimoni-stat {
    text-align: center;
    padding: 0.75rem;
    background: rgba(253, 248, 240, 0.6);
    border-radius: 12px;
}
.testimoni-stat .num {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #6B4226;
}
.testimoni-stat .lbl {
    font-size: 0.75rem;
    color: #7D6B5A;
    margin-top: 0.2rem;
}

/* ========================================
   LAYANAN — TAB INTERFACE
   ======================================== */

/* Service Tabs */
.service-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
}
.service-tab {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    border: 2px solid rgba(107, 66, 38, 0.12);
    background: transparent;
    color: #7D6B5A;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    font-family: 'Inter', sans-serif;
}
.service-tab i {
    font-size: 1rem;
    color: #C68642;
    transition: color 0.3s;
}
.service-tab:hover {
    border-color: #C68642;
    color: #6B4226;
    transform: translateY(-2px);
}
.service-tab.active {
    background: #6B4226;
    border-color: #6B4226;
    color: #fff;
    box-shadow: 0 6px 20px rgba(107, 66, 38, 0.25);
}
.service-tab.active i {
    color: #fff;
}

/* Service Panels */
.service-panels {
    position: relative;
    min-height: 300px;
}
.service-panel {
    display: none;
    animation: panelFadeIn 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.service-panel.active {
    display: block;
}
@keyframes panelFadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Panel Grid Layout */
.panel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background: #FDF8F0;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(44, 24, 16, 0.08);
}

.panel-image {
    height: 350px;
    background-size: cover;
    background-position: center;
    border-radius: 20px 0 0 20px;
}

.panel-info {
    padding: 2.5rem 2.5rem 2.5rem 0;
}
.panel-title {
    font-size: 1.5rem;
    color: #2C1810;
    margin-bottom: 0.75rem;
}
.panel-desc {
    color: #7D6B5A;
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
}

/* Highlights list */
.panel-highlights {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.panel-highlight {
    display: flex;
    align-items: center;
    gap: 1rem;
}
.hl-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, rgba(107, 66, 38, 0.08), rgba(198, 134, 66, 0.08));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C68642;
    font-size: 1.1rem;
    flex-shrink: 0;
}
.panel-highlight strong {
    display: block;
    font-size: 0.9rem;
    color: #2C1810;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
}
.panel-highlight small {
    font-size: 0.78rem;
    color: #7D6B5A;
}

/* Price tag */
.panel-price {
    font-size: 0.85rem;
    color: #6B4226;
    padding: 0.6rem 1rem;
    background: rgba(198, 134, 66, 0.1);
    border-radius: 10px;
    display: inline-block;
}
.panel-price strong {
    color: #C68642;
}

/* ========================================
   GALERI — FEATURED + CARD GRID
   ======================================== */
.gallery-layout {
    display: grid;
    grid-template-columns: 1.4fr 0.6fr 0.6fr;
    grid-template-rows: auto auto;
    gap: 0.8rem;
}

/* Featured large item — spans left column, full height */
.gallery-featured {
    grid-row: 1 / 3;
    cursor: pointer;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
}
.gallery-featured-img {
    height: 100%;
    min-height: 420px;
    background-size: cover;
    background-position: center;
    border-radius: 16px;
    position: relative;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.gallery-featured:hover .gallery-featured-img {
    transform: scale(1.05);
}
.gallery-featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44, 24, 16, 0.75) 0%, transparent 50%);
    border-radius: 16px;
    display: flex;
    align-items: flex-end;
    padding: 2rem;
}
.gallery-featured-label h3 {
    font-size: 1.5rem;
    color: #fff;
    margin: 0.5rem 0 0.25rem;
}
.gallery-featured-label p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.7);
    margin: 0;
}

/* Tag pills */
.gallery-featured-tag,
.gallery-card-tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #C68642;
    background: rgba(253, 248, 240, 0.15);
    backdrop-filter: blur(4px);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    border: 1px solid rgba(253, 248, 240, 0.2);
}

/* Small cards */
.gallery-card {
    cursor: pointer;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
}
.gallery-card-tall {
    grid-column: 2 / 4;
}
.gallery-card-img {
    height: 200px;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border-radius: 16px;
    position: relative;
}
.gallery-card:hover .gallery-card-img {
    transform: scale(1.05);
}
.gallery-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(44, 24, 16, 0.7) 0%, transparent 45%);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
}
.gallery-card-overlay h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #fff;
    margin: 0.5rem 0 0;
    font-weight: 500;
}
.gallery-card-tag {
    align-self: flex-start;
}

/* Lightbox */
.lightbox {
    position: fixed;
    inset: 0;
    background: rgba(44, 24, 16, 0.9);
    backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 2rem;
}

.lightbox.active {
    display: flex;
}

.lightbox-content {
    text-align: center;
    animation: lightboxIn 0.4s ease;
}

@keyframes lightboxIn {
    from { transform: scale(0.8); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

.lightbox-placeholder {
    width: 300px;
    height: 300px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: rgba(255, 255, 255, 0.3);
    margin: 0 auto;
}

.lightbox-img {
    width: 80vw;
    max-width: 600px;
    height: 60vh;
    max-height: 500px;
    border-radius: 16px;
    background-size: cover;
    background-position: center;
    margin: 0 auto;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3);
}

.lightbox-caption {
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
}

.lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 2rem;
    background: none;
    border: none;
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    transition: color 0.3s ease;
    line-height: 1;
}

.lightbox-close:hover {
    color: #fff;
}

/* ========================================
   TESTIMONI
   ======================================== */
.testimoni-carousel {
    max-width: 700px;
    margin: 0 auto;
    overflow: hidden;
    position: relative;
}

.carousel-track {
    display: flex;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
}

.carousel-slide {
    min-width: 100%;
    padding: 0 0.5rem;
}

.testimoni-card {
    background: #FDF8F0;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    text-align: center;
    box-shadow: 0 4px 20px rgba(44, 24, 16, 0.06);
}

.testimoni-stars {
    margin-bottom: 1rem;
    color: #C68642;
    font-size: 1rem;
    letter-spacing: 2px;
}

.testimoni-quote {
    font-size: 1.05rem;
    font-style: italic;
    color: #5D4A3A;
    line-height: 1.7;
    max-width: 550px;
    margin: 0 auto 1.5rem;
}

.testimoni-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
}

.testimoni-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6B4226, #8B5E3C);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1.1rem;
}

.testimoni-author h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2C1810;
}

.testimoni-author span {
    font-size: 0.8rem;
    color: #7D6B5A;
}

/* Carousel navigation dots */
.carousel-nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
}

.carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #D4C4B0;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
}

.carousel-dot.active {
    background: #6B4226;
    transform: scale(1.3);
}

.carousel-dot:hover {
    background: #8B5E3C;
}

/* ========================================
   KONTAK
   ======================================== */
.kontak-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
}

/* Form */
.kontak-form {
    background: #fff;
    padding: 2.5rem;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(44, 24, 16, 0.06);
}

.form-group {
    margin-bottom: 1.25rem;
}

.form-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 500;
    color: #6B4226;
    margin-bottom: 0.4rem;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 2px solid #E8D5C0;
    border-radius: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: #2C1810;
    background: #FDF8F0;
    transition: all 0.3s ease;
    outline: none;
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: #C68642;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(198, 134, 66, 0.1);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #B5A08C;
}

.form-group textarea {
    resize: vertical;
    min-height: 100px;
}

.form-toast {
    display: none;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    background: #E8F5E9;
    color: #2E7D32;
    border-radius: 12px;
    font-size: 0.9rem;
    font-weight: 500;
    text-align: center;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
}

.form-toast.show {
    display: flex;
}

.form-toast i {
    font-size: 1.2rem;
}

/* Info cards */
.kontak-info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.info-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 2px 12px rgba(44, 24, 16, 0.04);
    transition: all 0.3s ease;
    border: 1px solid rgba(107, 66, 38, 0.06);
}

.info-card:hover {
    transform: translateX(6px);
    box-shadow: 0 4px 20px rgba(44, 24, 16, 0.08);
    border-color: rgba(198, 134, 66, 0.15);
}

.info-card i {
    font-size: 1.3rem;
    color: #C68642;
    margin-top: 0.2rem;
    flex-shrink: 0;
    width: 24px;
    text-align: center;
}

.info-card h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: #2C1810;
    margin-bottom: 0.25rem;
}

.info-card p {
    font-size: 0.85rem;
    color: #7D6B5A;
    line-height: 1.5;
}

/* ========================================
   FOOTER
   ======================================== */
.footer {
    background: #2C1810;
    color: rgba(253, 248, 240, 0.8);
    padding-top: 4rem;
    position: relative;
    z-index: 20;
}
.footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, transparent, #C68642 20%, #D4A56A 50%, #C68642 80%, transparent);
}
.footer-container {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
}
.footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: #FDF8F0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
}
.footer-brand p {
    font-size: 0.85rem;
    max-width: 300px;
    margin-bottom: 1.25rem;
}
.footer-social {
    display: flex;
    gap: 0.75rem;
}
.footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(253, 248, 240, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    color: rgba(253, 248, 240, 0.6);
}
.footer-social a:hover {
    background: #C68642;
    border-color: #C68642;
    color: #fff;
    transform: translateY(-4px) scale(1.15);
    box-shadow: 0 4px 15px rgba(198, 134, 66, 0.3);
}
.footer-links h4 {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #FDF8F0;
    margin-bottom: 1rem;
    letter-spacing: 1px;
}
.footer-links ul li {
    margin-bottom: 0.5rem;
}
.footer-links ul li a {
    font-size: 0.85rem;
    color: rgba(253, 248, 240, 0.6);
    transition: color 0.3s ease, padding 0.3s ease;
    display: inline-block;
}
.footer-links ul li a:hover {
    color: #C68642;
    padding-left: 4px;
}
.footer-hours li {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: rgba(253, 248, 240, 0.6);
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(253, 248, 240, 0.05);
}
.footer-hours li:last-child {
    border-bottom: none;
}
.footer-bottom {
    border-top: 1px solid rgba(253, 248, 240, 0.08);
    padding: 1.5rem 0;
    text-align: center;
    margin-top: 1rem;
}
.footer-bottom p {
    font-size: 0.8rem;
    color: rgba(253, 248, 240, 0.4);
}
.footer-bottom i.fa-heart {
    color: #C68642;
    animation: heartBeat 1.5s ease-in-out infinite;
}
@keyframes heartBeat {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.2); }
    30% { transform: scale(1); }
    45% { transform: scale(1.15); }
    60% { transform: scale(1); }
}

/* ========================================
   RESPONSIVE
   ======================================== */

/* Tablet */
@media screen and (max-width: 768px) {
    .section {
        padding: 3.5rem 0;
    }

    .section-title {
        font-size: 1.8rem;
    }

    /* Nav */
    .nav-toggle {
        display: flex;
    }

    .nav-menu {
        position: fixed;
        top: 0;
        right: -100%;
        width: 280px;
        height: 100vh;
        background: #FDF8F0;
        flex-direction: column;
        padding: 5rem 2rem 2rem;
        gap: 0;
        transition: right 0.4s ease;
        box-shadow: -4px 0 20px rgba(44, 24, 16, 0.1);
    }

    .nav-menu.active {
        right: 0;
    }

    .nav-link {
        color: #7D6B5A;
        padding: 0.85rem 0;
        border-bottom: 1px solid rgba(44, 24, 16, 0.05);
        font-size: 1rem;
    }

    .nav-link::after {
        display: none;
    }

    .navbar.scrolled .nav-link {
        color: #7D6B5A;
    }

    /* Hero */
    .hero-content {
        grid-template-columns: 1fr;
        text-align: center;
        padding-top: 6rem;
    }

    .hero-title {
        font-size: 2.8rem;
    }

    .hero-desc {
        margin: 0 auto 2rem;
    }

    .hero-actions {
        justify-content: center;
    }

    .hero-decoration {
        display: none;
    }

    /* About */
    .about-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
    }

    .about-img-box {
        width: 240px;
        height: 280px;
    }

    .about-values {
        grid-template-columns: 1fr 1fr;
    }

    /* Services tabs */
    .service-tabs {
        gap: 0.4rem;
    }
    .service-tab {
        padding: 0.6rem 1rem;
        font-size: 0.8rem;
    }
    .service-tab span {
        display: none;
    }
    .panel-grid {
        grid-template-columns: 1fr;
    }
    .panel-image {
        height: 200px;
        border-radius: 20px 20px 0 0;
    }
    .panel-info {
        padding: 1.5rem;
    }
    .about-stats {
        grid-template-columns: repeat(2, 1fr);
    }

    /* Gallery */
    .gallery-layout {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
    }
    .gallery-featured {
        grid-row: auto;
        grid-column: 1 / 3;
    }
    .gallery-featured-img {
        min-height: 280px;
    }
    .gallery-card-tall {
        grid-column: auto;
    }

    /* Kontak */
    .kontak-grid {
        grid-template-columns: 1fr;
    }

    /* Footer */
    .footer-container {
        grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
        grid-column: span 2;
    }
}

/* Mobile */
@media screen and (max-width: 480px) {
    .section-title {
        font-size: 1.5rem;
    }

    .hero-title {
        font-size: 2.2rem;
    }

    .hero-tagline {
        font-size: 1rem;
    }

    .hero-actions {
        flex-direction: column;
        align-items: center;
    }

    .btn {
        width: 100%;
        justify-content: center;
    }

    .services-grid {
        grid-template-columns: 1fr;
    }

    .gallery-grid {
        grid-template-columns: 1fr;
    }

    .about-values {
        grid-template-columns: 1fr;
    }

    .footer-container {
        grid-template-columns: 1fr;
    }

    .footer-brand {
        grid-column: span 1;
    }

    .kontak-form {
        padding: 1.5rem;
    }

    .testimoni-card {
        padding: 1.5rem 1rem;
    }

    .lightbox-placeholder {
        width: 200px;
        height: 200px;
    }
}

/* ---------- SCROLL ANIMATIONS ---------- */
@media (prefers-reduced-motion: reduce) {
    .reveal {
        opacity: 1;
        transform: none;
        transition: none;
    }

    .service-card:hover,
    .gallery-item:hover {
        transform: none;
    }

    .hero-bg {
        background-attachment: scroll;
    }

    html {
        scroll-behavior: auto;
    }
}
