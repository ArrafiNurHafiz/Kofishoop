<?php
// Array asosiatif tarif gaji per hari berdasarkan golongan
$tarifGaji = [
    'A' => 200000,
    'B' => 150000,
    'C' => 100000
];

/**
 * Fungsi untuk menghitung total gaji karyawan
 *
 * @param string $golongan Golongan karyawan (A, B, atau C)
 * @param int    $hari     Jumlah hari kerja
 * @return array           Array berisi gajiPokok, tunjangan, dan total
 */
function hitungGaji($gol, $hari) {
    global $tarifGaji;

    // Hitung gaji pokok
    $gajiPokok = $tarifGaji[$gol] * $hari;

    // Tunjangan makan: Rp 50.000 jika hari kerja > 20
    $tunjangan = ($hari > 20) ? 50000 : 0;

    // Total gaji
    $total = $gajiPokok + $tunjangan;

    return [
        'gajiPokok' => $gajiPokok,
        'tunjangan' => $tunjangan,
        'total'     => $total
    ];
}

// Inisialisasi variabel untuk hasil
$hasil = null;
$namaKaryawan = '';

// Proses form jika disubmit
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $namaKaryawan = $_POST['nama'] ?? '';
    $golongan      = $_POST['golongan'] ?? '';
    $hari          = (int) ($_POST['hari'] ?? 0);

    // Validasi sederhana
    if (!empty($namaKaryawan) && isset($tarifGaji[$golongan]) && $hari > 0) {
        $hasil = hitungGaji($golongan, $hari);
    } else {
        $error = 'Harap isi semua data dengan benar.';
    }
}

/**
 * Format angka ke format Rupiah
 */
function formatRupiah($angka) {
    return 'Rp ' . number_format($angka, 0, ',', '.');
}
