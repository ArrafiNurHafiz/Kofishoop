@import "tailwindcss";

@theme inline {
  --color-background: #0c0c0c;
  --color-foreground: #f5f5f5;
  --color-surface: #141414;
  --color-surface-hover: #1c1c1c;
  --color-border: #1f1f1f;
  --color-border-hover: #2a2a2a;
  --color-accent: #d4a853;
  --color-accent-hover: #e0b85e;
  --color-accent-muted: rgba(212, 168, 83, 0.12);
  --color-muted: #a1a1aa;
  --color-muted-deeper: #52525b;
  --color-success: #4ade80;
  --color-error: #f87171;
  --color-warning: #fbbf24;
  --font-sans: "Outfit", sans-serif;
  --font-mono: "Geist Mono", "SF Mono", monospace;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  background: var(--color-background);
  color: var(--color-foreground);
  font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* Grain texture overlay — breaks digital flatness */
.grain-overlay {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
}

/* Typography utilities */
.tabular-nums {
  font-variant-numeric: tabular-nums;
}

.text-balance {
  text-wrap: balance;
}

/* Gold gradient accent — single hue family */
.gradient-text {
  background: linear-gradient(135deg, #d4a853 0%, #e8d5a3 50%, #d4a853 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Glow — gold tinted */
.glow-accent {
  box-shadow: 0 0 40px rgba(212, 168, 83, 0.1);
}

/* Card */
.card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 12px;
  padding: 24px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.card:hover {
  border-color: var(--color-border-hover);
}

.card-glow {
  box-shadow: 0 0 24px rgba(212, 168, 83, 0.05);
  border: 1px solid rgba(212, 168, 83, 0.12);
}

.card-glow:hover {
  border-color: rgba(212, 168, 83, 0.22);
  box-shadow: 0 0 36px rgba(212, 168, 83, 0.08);
}

/* Buttons — gold primary */
.btn-primary {
  background: linear-gradient(135deg, #d4a853 0%, #c49a3f 100%);
  color: #0c0c0c;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 600;
  font-size: 0.9375rem;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  line-height: 1.2;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #e0b85e 0%, #d4a853 100%);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: scale(0.98);
}

.btn-primary:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.04);
  color: #e5e5e5;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 500;
  font-size: 0.9375rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  line-height: 1.2;
}

.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.07);
  border-color: rgba(255, 255, 255, 0.14);
}

.btn-secondary:active {
  transform: scale(0.98);
}

.btn-secondary:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  transform: none;
}

/* Text button */
.btn-text {
  color: var(--color-muted);
  font-size: 0.875rem;
  font-weight: 500;
  transition: color 0.2s ease;
  cursor: pointer;
  background: none;
  border: none;
  padding: 4px 0;
}

.btn-text:hover {
  color: var(--color-foreground);
}

/* Input */
.input {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 8px;
  padding: 10px 14px;
  color: #f5f5f5;
  width: 100%;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  font-size: 0.9375rem;
  font-family: inherit;
}

.input:focus {
  border-color: rgba(212, 168, 83, 0.45);
  box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.08);
}

.input::placeholder {
  color: #52525b;
}

/* Progress bar */
.progress-bar {
  height: 4px;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 0.5s ease;
}

/* Badge */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  border-radius: 6px;
  font-size: 0.75rem;
  font-weight: 500;
  line-height: 1.5;
  border: 1px solid;
}

.badge-active {
  background: rgba(74, 222, 128, 0.08);
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.2);
}

.badge-executed {
  background: rgba(59, 130, 246, 0.08);
  color: #60a5fa;
  border-color: rgba(59, 130, 246, 0.2);
}

.badge-revoked {
  background: rgba(113, 113, 122, 0.08);
  color: #a1a1aa;
  border-color: rgba(113, 113, 122, 0.15);
}

/* Skeleton */
.skeleton {
  background: linear-gradient(90deg, rgba(255,255,255,0.03) 25%, rgba(255,255,255,0.06) 50%, rgba(255,255,255,0.03) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: 6px;
}

/* Animations */
@keyframes fade-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in {
  animation: fade-in 0.4s ease-out;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}
