"use client";

import { useEffect, useState } from "react";
import { useParams } from "next/navigation";
import { useAccount } from "wagmi";
import { ConnectButton } from "@rainbow-me/rainbowkit";
import { getWill, getBeneficiaries, WILL_STATUS } from "@/lib/eterna";

export default function ClaimPage() {
  const { id } = useParams<{ id: string }>();
  const { address, isConnected } = useAccount();
  const willId = BigInt(id);

  const [will, setWill] = useState<any>(null);
  const [beneficiaries, setBeneficiaries] = useState<any[]>([]);
  const [isBeneficiary, setIsBeneficiary] = useState(false);
  const [loading, setLoading] = useState(true);
  const [claiming, setClaiming] = useState(false);
  const [claimed, setClaimed] = useState(false);
  const [claimError, setClaimError] = useState("");

  useEffect(() => {
    loadData();
  }, [id]);

  async function loadData() {
    setLoading(true);
    try {
      const [w, b] = await Promise.all([
        getWill(willId),
        getBeneficiaries(willId),
      ]);
      setWill(w);
      setBeneficiaries([...b]);

      if (address) {
        const isBen = b.some(
          (ben: any) => ben.wallet.toLowerCase() === address.toLowerCase()
        );
        setIsBeneficiary(isBen);
      }
    } catch (err) {
      console.error("Error loading claim data:", err);
    } finally {
      setLoading(false);
    }
  }

  const handleClaim = async () => {
    setClaiming(true);
    setClaimError("");
    try {
      // In a full implementation, this would call the distribution contract
      await new Promise((r) => setTimeout(r, 2000));
      setClaimed(true);
    } catch (err: any) {
      setClaimError(err?.message || "Claim failed");
    } finally {
      setClaiming(false);
    }
  };

  if (loading) {
    return (
      <div className="flex-1 flex items-center justify-center">
        <div className="flex flex-col items-center gap-3">
          <div className="skeleton h-8 w-48" />
          <div className="skeleton h-4 w-32" />
        </div>
      </div>
    );
  }

  const willStatus = will ? Number(will.status) : 0;
  const isExecuted = willStatus === 1;
  const myBeneficiary = beneficiaries.find(
    (b: any) => address && b.wallet.toLowerCase() === address.toLowerCase()
  );

  return (
    <div className="flex-1 flex items-center justify-center px-4 py-8">
      <div className="max-w-lg w-full animate-fade-in">
        {/* Successfully claimed */}
        {claimed && (
          <div className="card card-glow border-[rgba(74,222,128,0.15)] text-center py-10">
            <div className="text-5xl mb-4" aria-hidden="true">✅</div>
            <h2 className="text-2xl font-bold mb-2">Claimed!</h2>
            <p className="text-[#a1a1aa]">
              Your inheritance has been successfully claimed.
            </p>
          </div>
        )}

        {/* Beneficiary claim panel */}
        {isConnected && isBeneficiary && isExecuted && !claimed && (
          <div className="card card-glow mb-6">
            <div className="text-center mb-6">
              <div className="text-4xl mb-4" aria-hidden="true">🎉</div>
              <h2 className="text-2xl font-bold mb-2">You Are a Beneficiary</h2>
              <p className="text-sm text-[#a1a1aa]">
                The owner of Will #{Number(willId)} has designated you as a beneficiary.
                Your share is ready to claim.
              </p>
            </div>

            <div className="mb-6 p-4 bg-[rgba(212,168,83,0.06)] rounded-lg border border-[rgba(212,168,83,0.12)] text-center">
              <p className="text-xs text-[#52525b] uppercase tracking-wider mb-1">Your Allocation</p>
              <p className="text-3xl font-bold gradient-text tabular-nums">
                {Number(myBeneficiary?.percentage) / 100}%
              </p>
              <p className="text-xs text-[#52525b] mt-1">of the estate</p>
            </div>

            <div className="space-y-3 text-sm mb-6">
              <div className="flex items-center gap-3 p-3 bg-white/[0.03] rounded-lg">
                <span className="w-6 h-6 rounded-full bg-[rgba(212,168,83,0.12)] flex items-center justify-center text-xs font-semibold text-[#d4a853]">
                  1
                </span>
                <span className="text-[#a1a1aa]">
                  Wallet connected — <span className="text-[#f5f5f5] font-mono text-[13px]">{address?.slice(0, 8)}...{address?.slice(-6)}</span>
                </span>
              </div>
              <div className="flex items-center gap-3 p-3 bg-white/[0.03] rounded-lg">
                <span className="w-6 h-6 rounded-full bg-[rgba(212,168,83,0.12)] flex items-center justify-center text-xs font-semibold text-[#d4a853]">
                  2
                </span>
                <span className="text-[#a1a1aa]">Verify your beneficiary status</span>
              </div>
              <div className="flex items-center gap-3 p-3 bg-white/[0.03] rounded-lg">
                <span className="w-6 h-6 rounded-full bg-[rgba(212,168,83,0.12)] flex items-center justify-center text-xs font-semibold text-[#d4a853]">
                  3
                </span>
                <span className="text-[#a1a1aa]">Claim your assets — they will be transferred automatically</span>
              </div>
            </div>

            {claimError && (
              <div className="mb-4 p-3 bg-[rgba(248,113,113,0.08)] border border-[rgba(248,113,113,0.2)] rounded-lg text-sm text-[#f87171]">
                {claimError}
              </div>
            )}

            <button
              onClick={handleClaim}
              disabled={claiming}
              className="btn-primary w-full py-3"
            >
              {claiming ? (
                <span className="inline-flex items-center gap-2">
                  <span className="w-4 h-4 border-2 border-[rgba(12,12,12,0.3)] border-t-[#0c0c0c] rounded-full animate-spin" />
                  Claiming...
                </span>
              ) : (
                "Claim Your Assets"
              )}
            </button>
          </div>
        )}

        {/* Will info card */}
        <div className="card">
          <div className="flex items-center gap-3 mb-4">
            <span className="text-xl" aria-hidden="true">📜</span>
            <div>
              <h2 className="text-xl font-bold">Will #{id}</h2>
              <span
                className={`text-sm ${
                  isExecuted ? "text-[#4ade80]" : willStatus === 0 ? "text-[#d4a853]" : "text-[#52525b]"
                }`}
              >
                {WILL_STATUS[willStatus]}
              </span>
            </div>
          </div>

          <div className="divide-y divide-white/[0.04]">
            <h3 className="font-semibold text-sm text-[#f5f5f5] mb-3">Beneficiaries</h3>
            {beneficiaries.map((b: any, i: number) => (
              <div key={i} className="flex items-center justify-between py-2.5 first:pt-0 last:pb-0">
                <div>
                  <p className="font-medium text-[#f5f5f5]">{b.name}</p>
                  <p className="text-xs text-[#52525b] font-mono">{b.wallet}</p>
                </div>
                <div className="text-right">
                  <p className="font-bold gradient-text tabular-nums">{Number(b.percentage) / 100}%</p>
                  {b.claimed && <p className="text-xs text-[#4ade80]">Claimed</p>}
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Connect wallet prompt */}
        {!isConnected && (
          <div className="card text-center mt-6 py-8">
            <p className="text-sm text-[#a1a1aa] mb-4">
              Connect your wallet to check if you are a beneficiary
            </p>
            <ConnectButton />
          </div>
        )}
      </div>
    </div>
  );
}
