import { createPublicClient, createWalletClient, custom, http, type Address } from "viem";
import { baseSepolia, sepolia } from "viem/chains";
import { config } from "./config";
import { ETERNA_WILL_ABI } from "./abi";

const chain = config.chainId === 84532 ? baseSepolia : sepolia;

export function getPublicClient() {
  return createPublicClient({
    chain,
    transport: http(config.rpcUrl),
  });
}

export function getWalletClient() {
  return createWalletClient({
    chain,
    transport: custom((window as any).ethereum!),
  });
}

export function getContract(address?: Address) {
  return {
    address: (address || config.contractAddress) as Address,
    abi: ETERNA_WILL_ABI,
  } as const;
}

// ---- Will Creation ----

export async function createWill(
  beneficiaries: Address[],
  percentages: bigint[],
  names: string[],
  delays: bigint[],
  guardians: Address[],
  guardianNames: string[],
  inactivityPeriod: bigint,
  guardianThreshold: bigint,
  minGuardians: bigint,
  encryptedDataHash: `0x${string}`
) {
  const walletClient = getWalletClient();
  const [account] = await walletClient.getAddresses();

  const hash = await walletClient.writeContract({
    address: config.contractAddress as Address,
    abi: ETERNA_WILL_ABI,
    functionName: "createWill",
    args: [
      beneficiaries,
      percentages,
      names,
      delays,
      guardians,
      guardianNames,
      {
        inactivityPeriod,
        guardianThreshold,
        minGuardians,
        useOracle: false,
      },
      encryptedDataHash,
    ],
    account,
  });

  const publicClient = getPublicClient();
  const receipt = await publicClient.waitForTransactionReceipt({ hash });

  // Parse WillCreated event
  const log = receipt.logs[0];
  const willId = Number(log.topics[1]); // indexed willId
  return { hash, willId, receipt };
}

// ---- Heartbeat ----

export async function sendHeartbeat(willId: bigint) {
  const walletClient = getWalletClient();
  const [account] = await walletClient.getAddresses();

  const hash = await walletClient.writeContract({
    address: config.contractAddress as Address,
    abi: ETERNA_WILL_ABI,
    functionName: "checkIn",
    args: [willId],
    account,
  });

  const publicClient = getPublicClient();
  return publicClient.waitForTransactionReceipt({ hash });
}

// ---- Guardian Vote ----

export async function voteAsGuardian(willId: bigint, isDeceased: boolean) {
  const walletClient = getWalletClient();
  const [account] = await walletClient.getAddresses();

  const hash = await walletClient.writeContract({
    address: config.contractAddress as Address,
    abi: ETERNA_WILL_ABI,
    functionName: "guardianVote",
    args: [willId, isDeceased],
    account,
  });

  const publicClient = getPublicClient();
  return publicClient.waitForTransactionReceipt({ hash });
}

