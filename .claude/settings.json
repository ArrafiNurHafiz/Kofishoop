{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:20128/v1",
    "ANTHROPIC_AUTH_TOKEN": "sk-2713f0d691ad9964-i5oa5d-4988fe67",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-Mythos-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-Fabel-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "ocg/deepseek-v4-flash",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "model": "sonnet",
  "hasCompletedOnboarding": true,
  "mcpServers": {
    "agentmemory": {
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://localhost:3111"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "grep-vercel": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "browsermcp": {
      "command": [
        "npx",
        "@browsermcp/mcp@latest"
      ]
    },
    "21st-dev-magic": {
      "command": [
        "npx",
        "-y",
        "@21st-dev/magic@latest"
      ],
      "env": {
        "API_KEY": "afa14deef3a5a8a653704a9cf510f976e64e36d7899f7520f024ca1ee8496da1"
      }
    },
    "gitmcp": {
      "type": "remote",
      "url": "https://gitmcp.io/docs"
    },
    "blender-mcp": {
      "command": [
        "blender-mcp"
      ]
    },
    "reactbits": {
      "command": [
        "node",
        "/home/arrafi/reactbits-mcp-server/dist/index.js"
      ]
    },
    "figma-developer-mcp": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "env": {
        "FIGMA_API_KEY": "figd_c6Lg0fPXIuGmgUt7xMj4y1P10ItTltHK4Wp_MK05"
      }
    },
    "agent-orchestrator": {
      "command": [
        "npx",
        "-y",
        "@ralphkrauss/agent-orchestrator@0.3.7"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$D/.claude/helpers/hook-handler.cjs\" ] || D=\"${HOME}\"; exec node \"$D/.claude/helpers/hook-handler.cjs\" pre-bash'",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$D/.claude/helpers/hook-handler.cjs\" ] || D=\"${HOME}\"; exec node \"$D/.claude/helpers/hook-handler.cjs\" pre-edit'",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$D/.claude/helpers/hook-handler.cjs\" ] || D=\"${HOME}\"; exec node \"$D/.claude/helpers/hook-handler.cjs\" post-edit'",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$D/.claude/helpers/hook-handler.cjs\" ] || D=\"${HOME}\"; exec node \"$D/.claude/helpers/hook-handler.cjs\" post-bash'",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'D=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$D/.claude/helpers/hook-handler.cjs\" ] || D=\"${HOME}\"; exec node \"$D/.claude/helpers/hook-handler.cjs\" route'",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
